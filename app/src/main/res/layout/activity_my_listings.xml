<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    tools:context=".myListings">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Listings"
                android:textColor="@color/surface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage your active posts"
                android:textColor="@color/nav_inactive"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Listings -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyListings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMessages"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Messages"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp"
            app:icon="@drawable/ic_messages"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp"
            app:iconTint="@color/nav_inactive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyListings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="My Listings"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_my_listings"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp"
            app:iconTint="@color/accent_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Marketplace"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp"
            app:icon="@drawable/ic_home"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp"
            app:iconTint="@color/nav_inactive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPost"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Create Post"
            android:textColor="@color/nav_inactive"
            android:textSize="11sp"
            app:icon="@drawable/ic_post"
            app:iconGravity="top"
            app:iconPadding="2dp"
            app:iconSize="20dp"
            app:iconTint="@color/nav_inactive" />
    </LinearLayout>
</LinearLayout>